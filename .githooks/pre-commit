#!/bin/sh
# Installed automatically via `npm install` in server/ (see
# server/scripts/setup-git-hooks.js). Runs the staged design-token and
# component-contract checks before each commit.

node server/scripts/check-design-tokens.js
if [ $? -ne 0 ]; then
  exit 1
fi

if [ ! -d server/node_modules/typescript ]; then
  echo "Component-contract check requires server dependencies. Run 'npm --prefix server install'." >&2
  exit 1
fi

node server/scripts/check-component-contracts.mjs --staged
